# Copia este archivo como backend/.env y completa tus datos de MySQL.
PORT=3000

# Conexión a MySQL (la base de datos y las tablas se crean solas al iniciar)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=byf_pqrs

# Clave para firmar las sesiones. Usa un texto largo y aleatorio (mínimo 32 caracteres).
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-al-menos-32-caracteres

# Duración de la sesión en horas
AUTH_TOKEN_HOURS=8

# Opcional: si la defines, se pedirá esta clave para crear la cuenta de administrador
# desde la página PQRS. Recomendado si el sitio está publicado en internet.
ADMIN_SETUP_KEY=
