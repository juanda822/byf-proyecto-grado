# Copia este archivo como backend/.env y completa tus datos de MySQL.
PORT=3000

# Conexión a MySQL (la base de datos y las tablas se crean solas al iniciar)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=byf_pqrs

# Clave para firmar las sesiones. Usa un texto largo y aleatorio (mínimo 32 caracteres).
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio-de-al-menos-32-caracteres

# Duración de la sesión en horas
AUTH_TOKEN_HOURS=8

# Opcional: si la defines, se pedirá esta clave para crear la cuenta de administrador
# desde la página PQRS. Recomendado si el sitio está publicado en internet.
ADMIN_SETUP_KEY=

# Opcional: carpeta donde se guardan las fotos de las PQRS (en hosting, un volumen permanente)
# UPLOAD_DIR=/data/uploads

# --- Avisos por correo (opcional) -----------------------------------------
# Railway bloquea el correo por SMTP, por eso se usa la API de Brevo (plan gratuito).
# BREVO_API_KEY: Brevo > SMTP & API > API Keys
# MAIL_FROM: un remitente verificado en Brevo > Senders
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=B&F Centro PQRS
# Correo de B&F que recibe el aviso de cada PQRS nueva y de los mensajes de clientes
ADMIN_NOTIFY_EMAIL=
# Dirección pública del sitio, para el botón de los correos (sin / al final)
SITE_URL=https://tu-sitio.up.railway.app

# Zona horaria para fechas del reporte y del Excel
APP_TIMEZONE=America/Bogota
